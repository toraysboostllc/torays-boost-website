# Variables que necesitan api/wholesale-*.js. Configurarlas en Vercel →
# Project Settings → Environment Variables. Nunca poner valores reales acá
# ni commitear un .env real.

# Mismo proyecto de Supabase que ya usa TORAYS BOOST DESK.
SUPABASE_URL=

# Clave con privilegio de saltar Row Level Security por completo — un secreto
# real. Se lee únicamente dentro de api/wholesale-*.js del lado del
# servidor — nunca en código de cliente, nunca con prefijo VITE_. Ver
# supabase/wholesale-migration.sql para las tablas que administra.
#
# SUPABASE_SECRET_KEY es la opción preferida — el formato moderno de
# Supabase (Project Settings → API Keys → "secret" key) para esta misma
# función. Si no está presente, el código cae en SUPABASE_SERVICE_ROLE_KEY
# (el JWT "service_role" legado) como fallback — basta con configurar UNA
# de las dos, no ambas. Si no se configura ninguna, los endpoints de
# wholesale responden 500 "not_configured".
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Tienda (/tienda) — api/shop.js. Reusa SUPABASE_URL + la clave secreta de
# arriba. Correr supabase/shop-preflight.sql -> shop-migration.sql ->
# shop-verify.sql en el mismo proyecto antes de activar.
# ---------------------------------------------------------------------------

# Quién puede entrar al panel /tienda/admin (con su login de Supabase/DESK).
SHOP_ADMIN_EMAILS=
# Clave PÚBLICA de Supabase (anon o publishable, la misma que usa DESK) para
# verificar ese login. Opcional: si falta, se usa la clave secreta.
SUPABASE_PUBLISHABLE_KEY=

# PayPal — developer.paypal.com -> Apps & Credentials. SANDBOX por defecto.
# Para cobrar dinero real hacen falta LAS DOS: PAYPAL_ENV=live y
# SHOP_LIVE_PAYMENTS_APPROVED=yes (y las credenciales Live, no las Sandbox).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook -> https://www.toraysboost.com/api/shop?op=paypal-webhook
# Eventos: PAYMENT.CAPTURE.COMPLETED, .PENDING, .DENIED, .REFUNDED, .REVERSED
PAYPAL_WEBHOOK_ID=
SHOP_LIVE_PAYMENTS_APPROVED=

# Envíos: los precios por opción (USPS / UPS) se configuran en el panel
# (Ajustes → Envío). Las etiquetas se compran a mano en Pirate Ship; no hay
# ninguna API de transportista conectada.

# Correos a clientes (Resend). Sin esto, los correos solo se registran en
# el panel como "no enviado". El remitente debe ser de un dominio
# verificado en Resend, p. ej. Torays Boost <pedidos@toraysboost.com>.
RESEND_API_KEY=
SHOP_EMAIL_FROM=
SHOP_EMAIL_REPLY_TO=

# Recogida en tienda: dirección, zona pública y horario se configuran en el
# panel (/tienda/admin -> Ajustes), no aquí.
SHOP_PUBLIC_ORIGIN=https://www.toraysboost.com
