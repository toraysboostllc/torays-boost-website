# Variables del lado del servidor (funciones en api/). Configurarlas en Vercel →
# Project Settings → Environment Variables. Nunca poner valores reales acá
# ni commitear un .env real.

# Mismo proyecto de Supabase que ya usa TORAYS BOOST DESK.
SUPABASE_URL=

# Clave con privilegio de saltar Row Level Security por completo — un secreto
# real. Se lee únicamente dentro de api/ del lado del servidor — nunca en
# código de cliente, nunca con prefijo VITE_.
#
# SUPABASE_SECRET_KEY es la opción preferida — el formato moderno de
# Supabase (Project Settings → API Keys → "secret" key) para esta misma
# función. Si no está presente, el código cae en SUPABASE_SERVICE_ROLE_KEY
# (el JWT "service_role" legado) como fallback — basta con configurar UNA
# de las dos, no ambas.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
